# 복사해서 .env 로 만들고 값을 채우세요.  cp .env.example .env
# .env 는 절대 git 에 올리지 마세요.

# CLOVA Studio 테스트 API 키 (CLOVA Studio > API 키 > 테스트)
CLOVASTUDIO_API_KEY=nv-xxxxxxxxxxxxxxxx

# CLOVA OCR > Domain > (General 도메인) > API Gateway 연동
CLOVA_OCR_INVOKE_URL=https://xxxxxxxx.apigw.ntruss.com/custom/v1/xxxxx/xxxxxxxx/general
CLOVA_OCR_SECRET=

# AI·NAVER API > Application > 인증 정보 (CLOVA Voice)
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=

# 튜닝 모델 작업 ID (CLOVA Studio > 튜닝 > 작업)
TUNED_TASK_ID=k6n4aqqb

# 튜닝 학습 생성용 (ml/tuning.py). 마이페이지 > 인증키 관리
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
TUNING_BUCKET=minwon-1120
